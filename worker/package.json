{
  "name": "jobberman-worker",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute jobberman --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute jobberman --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute jobberman --remote --file=./seed.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20250918.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}

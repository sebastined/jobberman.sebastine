{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobberman",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],

  // The "Mr Sebastine" account — where the sebastine.com zone lives. (Workers custom domains
  // only work when the Worker and the zone are in the same account.) Pinned because the API
  // token can see two accounts and wrangler can't pick one non-interactively.
  "account_id": "2e8613c8e1d71d6a8668e92d12f7d05e",

  // The custom domain is the only public surface: no workers.dev alias, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,

  "routes": [{ "pattern": "jobberman.sebastine.com", "custom_domain": true }],

  // Berlin-time 8am/9am/9pm/10pm, Mon-Fri, in UTC (fixed offset = CEST/summer; fires an hour
  // earlier by the clock during CET winter — same accepted drift as the old routine).
  // :00 screens the Italy-remote track, :30 the sponsorship track (see src/index.ts). Two
  // triggers keep each invocation inside the free plan's 50-subrequest limit.
  "triggers": {
    "crons": ["0 6,7,19,20 * * 1-5", "30 6,7,19,20 * * 1-5"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jobberman",
      "database_id": "d4ebcb0a-a357-44da-ab3e-4880da280b85"
    }
  ],

  // Static UI. Only /api/* runs the Worker; everything else is served straight from the asset store
  // (no invocation, no CPU), with the headers in public/_headers.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Set with `wrangler secret put <NAME>`; declared here so `wrangler types` types them and local dev warns when one is missing.
  "secrets": {
    "required": ["ANTHROPIC_API_KEY", "BRAVE_SEARCH_API_KEY", "TRACKER_TOKEN"]
  },

  "vars": {
    // Empty = api.anthropic.com. Only local testing overrides this (in .dev.vars) to point at a mock.
    "ANTHROPIC_BASE_URL": ""
  },

  // Full logs (structured JSON from src/log.ts); traces sampled, since a run makes dozens of subrequests.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.25 }
  }
}

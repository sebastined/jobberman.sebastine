{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobberman",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Public workers.dev URL only; preview URLs off so there's a single surface to protect.
  "workers_dev": true,
  "preview_urls": false,

  // Berlin-time 8am/9am/9pm/10pm, Mon-Fri, in UTC (fixed offset = CEST/summer; fires an hour
  // earlier by the clock during CET winter — same accepted drift as the old routine).
  // :00 screens the Italy-remote track, :30 the sponsorship track (see src/index.ts). Two
  // triggers keep each invocation inside the free plan's 50-subrequest limit.
  "triggers": {
    "crons": ["0 6,7,19,20 * * 1-5", "30 6,7,19,20 * * 1-5"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jobberman",
      "database_id": "3a3ee92f-6815-49e6-beb5-f31cbfdf78fc"
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }
}
